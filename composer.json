{
  "name": "cecil/plugin-example",
  "type": "cecil-theme",
  "description": "Cecil plugin example: a component theme shipping a plugin (generator, Twig extension, post-processor and events subscriber)",
  "keywords": ["Cecil", "plugin", "extension", "example"],
  "license": "MIT",
  "require": {
    "cecil/theme-installer": "^2.1"
  },
  "extra": {
    "cecil": {
      "theme-name": "plugin-example"
    },
    "branch-alias": {
      "dev-main": "2.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "cecil/theme-installer": true
    }
  }
}
